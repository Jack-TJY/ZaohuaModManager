<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ZaohuaModManager.Preloader</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>0.2.0</Version>
    <GameManaged Condition="'$(GameManaged)' == ''">..\lib</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\src\Shared\PendingOps.cs" Link="PendingOps.cs" />
    <Reference Include="BepInEx"><HintPath>$(GameManaged)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(GameManaged)\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
